# ==========================================================
# LOCAL DEVELOPMENT
# ==========================================================

SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True

DB_NAME=the_equalizer
DB_USER=root
DB_PASSWORD=replace-with-your-local-db-password
DB_HOST=127.0.0.1
DB_PORT=3306


# ==========================================================
# PRODUCTION / RENDER
# Do not put real production secrets in this file.
# Configure them in the Render dashboard instead.
# ==========================================================

# Supabase Database -> Connect -> Session pooler
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Render automatically provides RENDER_EXTERNAL_HOSTNAME.
# Only add values here for custom domains.
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Supabase Storage -> Configuration -> S3
# SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY_ID=replace
# SUPABASE_S3_SECRET_ACCESS_KEY=replace
# SUPABASE_S3_BUCKET=equalizer-media
# SUPABASE_S3_REGION=replace-with-project-region
